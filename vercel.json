{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/i/drnidhi-shubham",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/geo", "destination": "/api/geo.json" },
    { "source": "/opened", "destination": "/opened.html" },
    { "source": "/i/drnidhi-shubham", "destination": "/index.html" },
    { "source": "/i/drnidhi-shubham/:path*", "destination": "/index.html" }
  ]
}
